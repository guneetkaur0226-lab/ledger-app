# Firebase web app config (Project settings > General > Your apps > Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Project settings > Cloud Messaging > Web Push certificates > key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Project settings > Service accounts > Generate new private key. Paste the whole JSON file.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional, testing only: lets members use the website. Leave unset in production.
# NEXT_PUBLIC_ALLOW_MEMBER_WEB=true
